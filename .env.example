# ERPNext Integration Configuration
# Copy this file to .env and fill in your actual values

# ERPNext Instance URL (default: http://localhost:8080)
ERPNEXT_URL=http://localhost:8080

# ERPNext API Credentials
# To generate these:
# 1. Login to your ERPNext instance
# 2. Go to User Profile → API Access
# 3. Click "Generate Keys"
# 4. Copy the API Key and API Secret below

ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here
